# Solana cluster + RPC the browser uses (devnet by default)
NEXT_PUBLIC_SOLANA_CLUSTER=devnet
NEXT_PUBLIC_RPC_URL=https://api.devnet.solana.com
# RPC the server uses to verify each step (defaults to NEXT_PUBLIC_RPC_URL)
# RPC_URL_SERVER=
# Fixed demo SOL price used to turn USD card values into SOL loan sizes
NEXT_PUBLIC_SOL_USD=150
# Signs session cookies. Change this.
SESSION_SECRET=change-me
# Platform keys (base58 secret keys). If unset, they're generated into .data/ on first run.
# ESCROW_SECRET_KEY=
# VAULT_SECRET_KEY=
# Point at the ML scoring service when it's ready; unset = use data/factors.json
# SCORE_API_URL=
# Where the JSON store lives
# DATA_DIR=.data
